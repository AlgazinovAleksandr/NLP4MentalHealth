# ── LLM provider credentials ────────────────────────────────────────────────
# Used by the interviewer and therapist agents.
# Sign up at https://openrouter.ai → Keys → Create key (free tier available).
# The model below is free on OpenRouter; replace with any OpenAI-compatible
# model you prefer.
API_KEY='your-openrouter-api-key-here'
MODEL_NAME='nvidia/nemotron-3-super-120b-a12b:free'
BASE_URL='https://openrouter.ai/api/v1'

# ── Optional overrides ───────────────────────────────────────────────────────
# Path to the BERT triage model weights directory.
# Default (when blank): agentic_pipeline/synthetic_questionnaire_generation/
#                       runs/triage_bert_neutral/best_model/
# TRIAGE_MODEL_DIR=

# Path to the questionnaire JSON spec.
# Default (when blank): agentic_pipeline/synthetic_questionnaire_generation/
#                       registration_questionnaire_v0.0.1.json
# QUESTIONNAIRE_JSON=

# Path for the SQLite session log.
# Default (when blank): triage_interview_app/data/triage_sessions.sqlite
# TRIAGE_LOG_SQLITE=

# ── Docker Compose only ──────────────────────────────────────────────────────
# This variable is set automatically by docker-compose.yml to
# http://backend:8765 so the Streamlit container can reach the FastAPI
# container. You do NOT need to set it here when using Docker Compose.
# For local (non-Docker) use the default http://127.0.0.1:8765 applies.
# TRIAGE_API_URL=http://127.0.0.1:8765
